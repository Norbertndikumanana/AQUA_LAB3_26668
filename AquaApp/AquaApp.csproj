<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AquaApp</RootNamespace>
    <AssemblyName>AquaApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- NHibernate = the .NET version of Hibernate (ORM) -->
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <!-- PostgreSQL driver used by NHibernate -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local DB settings (git-ignored) are copied next to the exe when present -->
    <None Update="dbsettings.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('dbsettings.local.json')" />
    <None Update="dbsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
